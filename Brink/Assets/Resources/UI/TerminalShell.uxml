<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="TerminalShell.uss" />
    <Style src="VerticalSliceControls.uss" />
    <ui:VisualElement name="terminal-root" class="terminal-root bp-large">
        <ui:VisualElement name="status-bar" class="status-bar">
            <ui:Label name="classification-label" text="UNKNOWN GAME // CLASSIFIED█" class="classification" />
            <ui:VisualElement class="status-right">
                <ui:Label name="date-label" text="--- ----" class="status-stat" />
                <ui:Label name="cp-label" text="CP -" class="status-stat" />
                <ui:Button name="end-month-button" text="END MONTH" class="cmd-button primary" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="main-row" class="main-row">
            <ui:ScrollView name="nav-rail" class="nav-rail" mode="VerticalAndHorizontal" vertical-scroller-visibility="Hidden" horizontal-scroller-visibility="Hidden" />
            <ui:VisualElement name="content-host" class="content-host" />
        </ui:VisualElement>

        <ui:VisualElement name="rollover-overlay" class="crisis-overlay" style="display: none;">
            <ui:VisualElement name="rollover-panel" class="crisis-panel">
                <ui:Label name="rollover-title" text="MONTHLY BRIEFING" class="crisis-title" />
                <ui:ScrollView name="rollover-body" class="rollover-body" vertical-scroller-visibility="Hidden" horizontal-scroller-visibility="Hidden" />
                <ui:VisualElement name="rollover-actions" class="crisis-options" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="crisis-overlay" class="crisis-overlay" style="display: none;" />
    </ui:VisualElement>
</ui:UXML>